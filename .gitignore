# =============================================================================
# .gitignore — Files and directories ignored by Git
# =============================================================================

# --- Termux build output ------------------------------------------------------
# The 'output/' directory is used by termux-pkg-builder for build artifacts
output/

# Debian packages generated by 'build-package.sh'
*.deb

# Arch Linux packages (alternative packaging format)
*.pkg.tar.xz

# Termux build system working directory
.termux-build/

# --- OS-specific files -------------------------------------------------------
# macOS Finder metadata
.DS_Store

# Windows thumbnail cache
Thumbs.db

# --- IDE / editor settings ---------------------------------------------------
# VS Code workspace settings (keep user-level settings in your dotfiles)
.vscode/

# JetBrains IDEs (IntelliJ, Android Studio, CLion, etc.)
.idea/

# Vim swap files
*.swp
*.swo

# --- Build artifacts ---------------------------------------------------------
# The compiled binary (when building locally without DESTDIR)
src/termux-sample

# ndk patches backup
ndk-patches/*.orig

# Python bytecode cache
__pycache__/
err.log

# proot build artifacts
project/src/*.o
project/src/*.d
project/src/*.res
project/src/*.tmp
project/src/build.h
project/src/proot
project/src/cmd
project/src/loader/loader
project/src/loader/*.o
project/src/loader/*.d
project/src/licenses
